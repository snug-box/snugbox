# Settings for snugboxd, the Snugbox watcher. systemd reads this file as root
# each time the watcher starts, so after a change run:
#   sudo systemctl restart snugboxd
# A webhook address can carry a secret token, so only root can read this file.

# Send early warnings as JSON to this HTTPS address.
#SNUGBOX_WEBHOOK_URL=https://example.com/hooks/snugbox

# Never ask the cloud metadata service which provider and region this is.
#SNUGBOX_OFFLINE=true
