[Unit]
Description=Snugbox watcher, which measures what this box's memory is used for
Documentation=https://snugbox.dev/docs/watch/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snugbox
Group=snugbox
ExecStart={{.Bindir}}/snugboxd
EnvironmentFile=-/etc/snugbox/snugboxd.env
Environment=GOMEMLIMIT=20MiB
Restart=on-failure
RestartSec=10s

# The watcher reads every process's memory map, which needs CAP_SYS_PTRACE,
# and every cgroup file, which CAP_DAC_READ_SEARCH covers. Both only read.
AmbientCapabilities=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes

StateDirectory=snugbox
StateDirectoryMode=0750
RuntimeDirectory=snugbox
RuntimeDirectoryMode=0750
# /run/snugbox also holds the helper's socket, so it stays when the watcher
# stops; /run is emptied at boot anyway.
RuntimeDirectoryPreserve=yes
UMask=0027

ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

# Blueprint section 9.4: a tool that sells memory savings uses almost none.
MemoryMax=64M
ManagedOOMPreference=omit

[Install]
WantedBy=multi-user.target
